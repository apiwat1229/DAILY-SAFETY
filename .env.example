NODE_ENV=production
PORT=4000
HOST=0.0.0.0
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-admin-password
LEADER_PASSWORD=replace-leader-password
APP_TIME_ZONE=Asia/Bangkok
# Optional: extra browser origins allowed to call the API (comma separated), e.g. https://safety.example.com
# ALLOWED_ORIGINS=

# Nightly backup (production default: on). Stored in <data>/backups; copy them off the server for real disaster recovery.
# BACKUP_ENABLED=true
# BACKUP_HOUR=2
# BACKUP_KEEP=7
